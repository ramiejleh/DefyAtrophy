#!/usr/bin/env node
// The line-by-line CLI. Commands call it by its full path, "${CLAUDE_PLUGIN_ROOT}/cli/line-by-line".
// (Not in bin/: claude.ai and Cowork refuse plugins with a top-level bin/ directory.)
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";
import { realpathSync } from "node:fs";

const root = dirname(dirname(realpathSync(fileURLToPath(import.meta.url))));
const { main } = await import(pathToFileURL(join(root, "lib", "cli.js")).href);
await main(process.argv.slice(2));
